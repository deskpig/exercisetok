+  .radio-options { gap: 4px var(--space-4); }
+  .rubric-field legend { font-size: 12px; }
+  .setup-options button { font-size: 11px; }
+  .editor-actions { gap: var(--space-2); padding-block: var(--space-4); }
+  .editor-actions button { padding-inline: var(--space-3); }
+  .viewer { padding: var(--space-3); }
+  .clear-dialog { padding: var(--space-5); }
+}
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { transition: none !important; scroll-behavior: auto !important; }
+}
+@media (forced-colors: active) {
+  input[type=radio], input[type=checkbox] { appearance: auto; }
+  input[type=radio]::after, input[type=checkbox]::after { display: none; }
+  button, .button { border-color: ButtonText; }
+}
